            ],
            "url": "{{baseUrl}}/auth/cambiar-password",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"nuevaPassword\": \"Nueva123!\"\n}"
            },
            "auth": {
