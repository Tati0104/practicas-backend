# Copia este archivo como .env (no subas .env al repositorio)
# cp .env.example .env   — Linux/Mac
# copy .env.example .env — Windows

# URL del backend Spring Boot (local o EC2)
VITE_API_URL=http://localhost:8080

# IMPORTANTE: ejecuta el frontend en http://localhost:5173 (npm run dev).
# Si Vite usa otro puerto (5174, 5175…), el login puede fallar por CORS en producción.

# Fuente de datos para listados del frontend:
#   false → solo backend real (PostgreSQL). Recomendado para pruebas integradas y producción.
#   true  → solo datos mock locales (sin llamadas HTTP de lectura). Útil sin backend.
VITE_USE_MOCKS=false
