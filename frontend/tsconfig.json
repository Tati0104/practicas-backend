{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    /* 👇 Esto es lo que hace que TypeScript reconozca beforeAll, afterEach, afterAll, describe, it, expect, etc. */
    "types": ["vitest/globals"]
  },
  "include": ["src"]
}
